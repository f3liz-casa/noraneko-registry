  },

  "key_tag": "key",
  "key_combo": {
    "note": "押しかたは一つの字で書く(\"Accel+Alt+Z\")。keycode / key / modifiers に綴り直すのは殻。Accel は、どこでも同じ指(Windows と Linux では Ctrl、macOS では Cmd)。",
    "modifiers": {
      "accel": "accel",
      "ctrl": "control",
      "control": "control",
      "alt": "alt",
      "option": "alt",
      "shift": "shift",
      "meta": "meta",
      "cmd": "meta"
    },
    "named": {
      "f1": "VK_F1", "f2": "VK_F2", "f3": "VK_F3", "f4": "VK_F4",
      "f5": "VK_F5", "f6": "VK_F6", "f7": "VK_F7", "f8": "VK_F8",
      "f9": "VK_F9", "f10": "VK_F10", "f11": "VK_F11", "f12": "VK_F12",
      "enter": "VK_RETURN", "return": "VK_RETURN",
      "escape": "VK_ESCAPE", "esc": "VK_ESCAPE",
      "space": "VK_SPACE", "tab": "VK_TAB",
      "delete": "VK_DELETE", "backspace": "VK_BACK", "insert": "VK_INSERT",
      "home": "VK_HOME", "end": "VK_END",
      "pageup": "VK_PAGE_UP", "pagedown": "VK_PAGE_DOWN",
      "up": "VK_UP", "down": "VK_DOWN", "left": "VK_LEFT", "right": "VK_RIGHT"
    }
  },

  "props": {
    "note": "view が書ける属性。ここに無いものは落として console に一行。`style` はデータ(style.ts が印字する)、`on:*` は行事、どちらもこの表の外。",
    "any": [
      "id", "class", "hidden", "disabled", "collapsed", "key",
      "label", "value", "tooltiptext", "title", "image", "src", "href", "alt",
      "flex", "align", "pack", "orient", "dir", "crop", "type", "placeholder",
      "width", "height", "minwidth", "minheight", "maxwidth", "maxheight",
      "checked", "selected", "context", "accesskey", "colspan", "rowspan"
    ],
    "prefixes": ["aria-"],
    "url_valued": ["src", "href", "image"],
    "url_schemes": ["https:", "http:", "resource:", "moz-extension:", "page-icon:"],
    "url_prefixes": ["chrome://global/skin/"]
  }
}
