              "key": "rename"
            },
            "acceltext": "F2",
            "on:command": {
              "__type": "Rename",
              "tab": ""
            }
          },
          "kids": []
        },
        {
          "__type": "VNode",
          "tag": "menuitem",
          "props": {
            "id": "nora-rename-tab-clear",
            "class": "nora-rename-clear",
            "label": {
              "__type": "T",
              "key": "clear"
            },
            "on:command": {
              "__type": "Named",
              "tab": "",
              "value": ""
            }
          },
          "kids": []
        }
      ]
    }
  },
  "effects": [
