--- setup
{
  "__type": "Setup",
  "anchors": [
    {
      "__type": "Anchor",
      "name": "keys",
      "at": "keyset",
      "selector": null,
      "tag": null,
      "id": "nora-rename-tab-keys",
      "area": null,
      "menu": null
    },
    {
      "__type": "Anchor",
      "name": "menu",
      "at": "menu",
      "selector": null,
      "tag": null,
      "id": "nora-rename-tab-menu",
      "area": null,
      "menu": "tabContextMenu"
    }
  ],
  "style": ".tabbrowser-tab[{attr}name] .tab-label::before {  content: var({var}name); font-size: 1rem; }.tabbrowser-tab[{attr}name] .tab-label { font-size: 0; }.nora-rename-clear:not([{attr}name]) { display: none; }",
  "prefs": [],
  "prefs_json": [],
  "watch": {
    "__type": "Watch",
    "tabs": [
      "open",
      "restore",
      "close",
      "select",
      "dblclick"
    ]
  },
  "tab_values": [
    "name"
  ],
  "window_values": [],
  "restore": null
}
--- start [{"prefs":{},"url":"","tabs":[{"id":"tab1","index":0,"title":"Firefox","selected":true,"values":{}},{"id":"tab2","index":1,"title":"ねこ図鑑","selected":false,"values":{"name":"ねこ"}}]}]
{
  "__type": "Frame",
  "view": {
    "keys": {
      "__type": "VNode",
      "tag": "key",
      "props": {
        "combo": "F2",
        "on:command": {
          "__type": "Rename",
          "tab": ""
        }
      },
      "kids": []
    },
    "menu": {
      "__type": "VNode",
      "tag": "fragment",
      "props": {},
