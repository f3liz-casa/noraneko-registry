# SPDX-License-Identifier: MPL-2.0
#
# std: the few words a drop's logic keeps reaching for. The runtime loads this
# before the drop's own ops/*.tsubaki, so they are simply there.
#
# 鍵のこと。JS から渡ってくる Dict の鍵は文字列しかない(JS の object に
# 他の鍵は無い)。ここで組む Dict は `:width => 40px` の Symbol -- Julia で
# 「名前」を綴るとやりかた。**`:name` で訊けば、どちらの綴りでも見つかる**:
# `get(a, :id, "")` は `"id"` の鍵も `:id` の鍵も読むし、`put` は、もう居る
# ほうに書く(両方が増えないように)。
#
# 逆は、そうしない。`get(a, "id", "")` は文字列の鍵だけを見る -- Julia の
# Dict では Symbol と文字列は別の鍵で、そこは言語のほうに合わせている。
# 「名前で訊く」が `:name` で、そのときだけ、JS から来たかどうかを気にしなくて
# いい、という形。
#
# `a[:id]` には、この作法を教えられない(Dict の添字は dispatch を通らない)。
# `get` は Julia の形のまま -- 既定はいつも声に出して言う -- なので、二引数の
# `get` はここには無い。

"d の中で、k と同じ意味の鍵。Symbol と、その名前の文字列は、同じ鍵。無ければ nothing"
function samekey(d::Dict, k::Symbol)
    name = string(k)
    for kk in keys(d)
        if kk isa Symbol
            if kk == k
                return kk
            end
        elseif kk isa String
            if kk == name
                return kk
            end
        end
    end
    return nothing
end

function get(d::Dict, k::Symbol, default)
    kk = samekey(d, k)
    if kk isa Nothing
        return default
    end
    return d[kk]
end

function haskey(d::Dict, k::Symbol)
    return !(samekey(d, k) isa Nothing)
end

"a copy of d. (Tsubaki has no `copy` for a Dict of its own yet.)"
function copy(d::Dict)
    n = Dict()
    for k in keys(d)
        n[k] = d[k]
    end
    return n
end

"その場で書く。同じ意味の鍵がもう居るなら、そちらに書く(両方が増えないように)"
function setkey!(d::Dict, k, value)
    d[k] = value
    return d
end

function setkey!(d::Dict, k::Symbol, value)
    kk = samekey(d, k)
    if kk isa Nothing
        d[k] = value
    else
        d[kk] = value
    end
    return d
end

"a copy of d with one key set: the state is never changed in place"
function put(d::Dict, key, value)
    return setkey!(copy(d), key, value)
end

"二つを重ねた新しい Dict。同じ鍵は、後ろが勝つ"
function merge(a::Dict, b::Dict)
    n = copy(a)
    for k in keys(b)
        setkey!(n, k, b[k])
    end
    return n
end

# --- 長さと単位 ---------------------------------------------------------------
# 数のすぐ隣に名前を置くと掛け算になる(Julia の juxtaposition)ので、`40px` は
# `40 * px`。掛け算を一つ教えれば、それが単位になる。計算したものは `w * px`
# と書く(Julia でも `(3*w)px` とは書けない)。
#
# 単位の名前は短いので、`s`(秒)のように、うっかり変数名とぶつかりやすいものも
# ある。関数の中の `s = ...` は外を覆うので、そこは困らない。

"数と単位。style の値として、殻が CSS に印字する"
struct Len
    n
    unit
end

function *(n::Int, u::Symbol)
    return Len(n, u)
end

function *(n::Float64, u::Symbol)
    return Len(n, u)
end

px = :px
pct = :pct
em = :em
rem = :rem
fr = :fr
s = :s
ms = :ms
deg = :deg

# --- 色の棚 --------------------------------------------------------------------
# `var(--toolbar-bgcolor, var(--toolbar-background-color))` を毎回書かないための棚。
# 名前は「どこの色か」ではなく **何の色か**(bg / text / hover)にしてある --
# drop が窓の中に居ても about: の頁に居ても、同じ名前で呼べるように。
#
# **fallback は必ず system color で終わる**(Canvas / CanvasText / Menu / MenuText /
# Field / FieldText / AccentColor / ButtonBorder)。その文書に Firefox の変数が
# 無くても色は出るし、明るい / 暗いの切り替えは Firefox と OS がしてくれる --
# drop は何もしなくていい。**自分で色を決めないほうが、ブラウザに似る。**
#
# 一行で一つ、名前と値が隣に並ぶ形。値は文字列なので、style を Dict で書いても、
# 字を連ねる書きかたでも、どちらでも置ける。

module Theme
    # `--toolbar-bgcolor` は **toolbox の中でしか定義されていない**。#browser の中に
    # 置いたもの(タブの横の帯など)からは届かないので、その次に
    # `--toolbar-background-color`(browser.xhtml の root に居る)を置く。
    # 実機で確かめた: 帯の位置で --toolbar-bgcolor は無し、--toolbar-background-color は
    # light-dark(#f9f9fb, rgb(43, 42, 51))。ここを飛ばすと Canvas まで落ちて、色が変わる。
    const bg = "var(--toolbar-bgcolor, var(--toolbar-background-color, var(--in-content-page-background, Canvas)))"
    const text = "var(--toolbar-color, var(--in-content-page-color, CanvasText))"
    const muted = "color-mix(in srgb, currentColor 60%, transparent)"
    const separator = "var(--chrome-content-separator-color, var(--in-content-border-color, ButtonBorder))"
    const hover = "var(--toolbarbutton-hover-background, color-mix(in srgb, currentColor 12%, transparent))"
    const active = "var(--toolbarbutton-active-background, color-mix(in srgb, currentColor 20%, transparent))"
    const accent = "var(--focus-outline-color, AccentColor)"
    const panel_bg = "var(--arrowpanel-background, Menu)"
    const panel_text = "var(--arrowpanel-color, MenuText)"
    const field_bg = "var(--in-content-box-background, Field)"
    const field_text = "var(--in-content-box-text-color, FieldText)"
end

# --- actor を Tsubaki で書くときの言葉 -----------------------------------------
# 殻(_shared/tsubakiActor.ts)と、ここで形を合わせている。struct は JS 側へ
# `{__type => 名前, ...}` の形で渡るので、effect はそのまま「何をするか」の名前になる。

"view の一節。tag と props と子。DOM も preact も知らない"
struct VNode
    tag
    props
    kids
end

# props はそのまま要素に渡る。"on:command" => Action の値は closure ではなく
# 「起こす action」そのもの(closure は postMessage を越えない)。
# "style" => Dict("width" => "320px") のように Dict で書けば inline style になる
# (字を連ねると `;` の混入を自分で見張ることになるので、Dict のほうを)。

el(tag, props, kids) = VNode(tag, props, kids)
el(tag, props) = VNode(tag, props, [])
el(tag) = VNode(tag, Dict(), [])

# --- 三つの door の、二つの答えの形 ---------------------------------------------
#
#     setup()           Setup(...)   どこに置くか / style / 見ていてほしい pref
#     start(facts)      Frame(...)   最初の一枚
#     dispatch(action)  Frame(...)   次の一枚と、してほしいこと

# 置き場所ひとつ。**書かなかったところは、殻が決める** -- selector は "body"、
# tag は XUL の文書なら "vbox"、そうでなければ "html:div"、at は「その中」。
# ここで同じ既定を書き写すと、殻と二か所で決めることになるので、書かない。
#
#     Anchor(selector = "#urlbar", at = "after")
#     Anchor(name = "menu", selector = "#mainPopupSet", at = "parent", tag = "menupopup")
#
# 一つだけなら name は要らない(殻が "main" と呼ぶ)。二つ以上なら、それぞれに
# name を書いて、view はその名前で答える。
"置き場所ひとつ。書かなかったところは、殻が決める"
struct Anchor
    name
    at
    selector
    tag
    id
    function Anchor(; name = nothing, at = nothing, selector = nothing, tag = nothing, id = nothing)
        return new(name, at, selector, tag, id)
    end
end

# anchors は「置き場所」の並び。
#
#     Setup(anchors = [Anchor(selector = "#urlbar", at = "after")],
#           style = Style.sheet(), prefs = ["nora.drop.example.on"])
#
# 既定が **空ではなく一つ**なのは、殻が「anchors が空の並び」を「どこにも置かない」
# と読むから -- `Setup()` と書いた人が待っているのは、それではない。
"setup() の答え。どこに置くか、その style、見ていてほしい pref"
struct Setup
    anchors
    style
    prefs
    prefs_json
    function Setup(; anchors = [Anchor()], style = nothing, prefs = [], prefs_json = [])
        return new(anchors, style, prefs, prefs_json)
    end
end

# 一枚 = 描くものと、してほしいこと。
# view は VNode 一つ(置き場所も一つのとき)か、Dict(anchor の名前 => VNode)。
# 窓の中の離れた二か所(タブの横の列と、#mainPopupSet の下の menupopup)は
# 一本の木にできないので、setup が "anchors" で名前をつけて、ここでその名前に答える。
"start と dispatch の答え。描くものと、してほしいこと"
struct Frame
    view
    effects
    function Frame(view, effects = [])
        return new(view, effects)
    end
end

# 前からの綴り。`frame(view)` と書いてある drop は、そのまま動く
frame(view) = Frame(view)
frame(view, effects) = Frame(view, effects)

# 殻が carry out できることの全部(これ以上が要る drop は actor.ts を書く)
struct SetPref
    name
    value
end

struct OpenURL
    url
end

struct Log
    text
end

# 自分が置いたものの中の menupopup を、画面のこの場所で開く
struct OpenPopup
    selector
    x
    y
end

# 自分が置いた <browser> の、いま読んでいるページを読み直す
struct ReloadFrame
    selector
end

# --- 事実を「訊く」--------------------------------------------------------------
# logic は事実を作らない。新しい uuid も、いま見ているタブの URL も、drag のあとに
# 箱が実際になった幅も、こちらでは分からない。action に穴を開けて殻に埋めさせるので
# はなく、**訊いて、名前をつけた action で返してもらう**。返事は普通の dispatch で
# 来るので、「外から来るものは action に詰めてから投げる」の形のまま。

# 集まったら Dict("__type" => action, 名前 => 値) が dispatch される。
# いま訊ける事実は二つ:
#   "uuid"  新しい uuid
#   "url"   いま見ているタブの URL(http/https のときだけ。ほかは "")
#
#     Ask(["uuid", "url"], "AddPanel")
"殻に事実を訊く。返事は、その名前の action で来る"
struct Ask
    fields
    action
end

# 返事は Dict("__type" => action, "width" => …, "height" => …)。
# selector は **この drop が置いた host とその中**だけを探す(ブラウザの他の場所は
# 見ない)。view が id を書いているなら、その id をそのまま渡せる。
#
#     Measure("#nora-webpanel-box", "SetWidth")
"自分が置いたものの中の、この selector に当たる要素の実測を訊く"
struct Measure
    selector
    action
end
