--- start [{"prefs":{},"url":""}]
{
  "__type": "Frame",
  "view": {
    "__type": "VNode",
    "tag": "toolbarbutton",
    "props": {
      "id": "nora-undo-closed-tab-button",
      "class": "toolbarbutton-1 chromeclass-toolbar-additional",
      "label": {
        "__type": "T",
        "key": "label"
      },
      "tooltiptext": {
        "__type": "T",
