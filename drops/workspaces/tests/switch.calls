# 窓での一周。束が二つ(a=しごと、b=よみもの)、タブ三枚。
# tab3 は b の束なので、いまは仕舞われている(前の起動から、そうやって戻ってきた)

setup

start [{"prefs":{"noraneko.workspaces.list":[{"id":"a","name":"しごと"},{"id":"b","name":"よみもの"}]},"url":"","tabs":[{"id":"tab1","index":0,"title":"Firefox","selected":true,"hidden":false,"values":{"ws":"a"}},{"id":"tab2","index":1,"title":"ねこ図鑑","selected":false,"hidden":false,"values":{"ws":"a"}},{"id":"tab3","index":2,"title":"詩","selected":false,"hidden":true,"values":{"ws":"b"}}],"window":{"ws":"a"}}]

# よみものの束へ。**先に選んで、あとで仕舞う** -- 選ばれているタブは本体が仕舞わない
dispatch [{"__type":"Switch","ws":"b"}]

# 殻が、選ばれたことと仕舞われたことを、一覧で教えてくる
dispatch [{"__type":"TabsChanged","kind":"select","tab":{"id":"tab3"},"tabs":[{"id":"tab1","index":0,"title":"Firefox","selected":false,"hidden":true,"values":{"ws":"a","last":"a"}},{"id":"tab2","index":1,"title":"ねこ図鑑","selected":false,"hidden":true,"values":{"ws":"a"}},{"id":"tab3","index":2,"title":"詩","selected":true,"hidden":false,"values":{"ws":"b"}}]}]

# 新しいタブが開いた。束を持っていないので、いまの束(b)のものになる
dispatch [{"__type":"TabsChanged","kind":"open","tab":{"id":"tab4","index":3,"title":"新しいタブ","selected":true,"hidden":false,"values":{}},"tabs":[{"id":"tab1","index":0,"selected":false,"hidden":true,"values":{"ws":"a","last":"a"}},{"id":"tab2","index":1,"selected":false,"hidden":true,"values":{"ws":"a"}},{"id":"tab3","index":2,"selected":false,"hidden":false,"values":{"ws":"b"}},{"id":"tab4","index":3,"selected":true,"hidden":false,"values":{}}]}]

# しごとの束に戻る。最後に見ていたタブ(tab1)が選ばれて、b の二枚が仕舞われる
dispatch [{"__type":"Switch","ws":"a"}]

# 同じ束をもう一度押しても、何も起きない
dispatch [{"__type":"Switch","ws":"a"}]

# よみものの束を消した(設定の頁から)。その中のタブは、いまの束に移る -- 閉じない
dispatch [{"__type":"PrefChanged","name":"noraneko.workspaces.list","value":[{"id":"a","name":"しごと"}]}]

# タブの右クリック → 別の束へ。いま a の束に tab1..tab4 が集まっている状態から、
# 見ていないタブ(tab2)を b12 の束へ移す
dispatch [{"__type":"PrefChanged","name":"noraneko.workspaces.list","value":[{"id":"a","name":"しごと"},{"id":"b12","name":"よみもの"}]}]
dispatch [{"__type":"Move","ws":"b12","tab":"","__event":{"tab":"tab2"}}]

# こんどは **見ているタブ**を移す。先にこの束の別のタブへ移ってから、仕舞われる
dispatch [{"__type":"TabsChanged","kind":"select","tab":{"id":"tab1"},"tabs":[{"id":"tab1","index":0,"selected":true,"hidden":false,"values":{"ws":"a","last":"a"}},{"id":"tab2","index":1,"selected":false,"hidden":true,"values":{"ws":"b12"}},{"id":"tab3","index":2,"selected":false,"hidden":false,"values":{"ws":"a"}},{"id":"tab4","index":3,"selected":false,"hidden":false,"values":{"ws":"a"}}]}]
dispatch [{"__type":"Move","ws":"b12","tab":"","__event":{"tab":"tab1"}}]

# よみものの束へ移って、こんどは逆向きに一枚返す。
# 手元の一覧に「仕舞った」が書けていないと、ここで「もう見えている」と思って
# 何も出ず、タブは仕舞われたまま残る(右クリックの行は、いまの束を出さないので、
# 返すときは移った先から)
dispatch [{"__type":"Switch","ws":"b12"}]
dispatch [{"__type":"Move","ws":"a","tab":"","__event":{"tab":"tab2"}}]

# 前の起動から戻ってくるタブ。覚書がまだ結びついていないので「束を持っていない」
# ように見えるけれど、**開いたときには引き受けない** -- 引き受けると、よみものの
# タブを しごと に奪ってしまう(実機で一度やった)
dispatch [{"__type":"TabsChanged","kind":"open","tab":{"id":"tab9","index":5,"selected":false,"hidden":false,"values":{}},"tabs":[{"id":"tab1","index":0,"selected":false,"hidden":false,"values":{"ws":"a"}},{"id":"tab9","index":5,"selected":false,"hidden":false,"values":{}}]}]

# 人がそのタブを選んだら、覚書は読める。そこで引き受ける
dispatch [{"__type":"TabsChanged","kind":"select","tab":{"id":"tab9"},"tabs":[{"id":"tab1","index":0,"selected":false,"hidden":false,"values":{"ws":"a"}},{"id":"tab9","index":5,"selected":true,"hidden":false,"values":{}}]}]
