# 一枚ぶんの筋。state を持たないので、筋も短い

# 置き場所(タブの右クリックの、末尾の二行)
setup

# 最初の一枚。tabs を宣言していないので、facts にタブは入ってこない
start [{"prefs":{},"url":""}]

# 「いま見ているタブへ」が押された → 命令を一つ。
# 殻は __event に「右クリックされたタブ」を入れてくるが、この drop は読まない
# (行き先は、いつも向こうにある)-- 効果に tab が出てこないことが、ここで見える
dispatch [{"__type":"Show","__event":{"tab":"tab2"}}]

# 「音の鳴っているタブへ」。どのタブが鳴っているかも、drop は知らない
dispatch [{"__type":"Playing"}]
